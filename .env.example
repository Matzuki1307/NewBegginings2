# Copia este archivo como .env para correr la app sin Docker (npm start).
# Con Docker Compose no hace falta: las variables están en docker-compose.yml.

# Postgres local (por ejemplo, solo el servicio db: docker compose up db)
DATABASE_URL=postgres://newbeginnings:newbeginnings@localhost:5432/newbeginnings
# Para Neon u otro Postgres en la nube, usa la URL que te den, con ?sslmode=require al final

# Cadena larga y aleatoria. Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esto

PORT=3000

# Primer administrador: se crea al arrancar si ese correo no existe todavía.
# Después de crearlo puedes cambiar su contraseña desde la app y quitar estas variables.
ADMIN_EMAIL=admin@newbeginnings.local
ADMIN_PASSWORD=cambia-esto-Admin1
